{
  "name": "finisus",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/angular.mjs serve",
    "build": "node scripts/angular.mjs build",
    "watch": "node scripts/angular.mjs build --watch --configuration development",
    "test": "node scripts/angular.mjs test --watch=false",
    "test:cobertura": "node scripts/angular.mjs test --watch=false --coverage",
    "typecheck": "ngc -p tsconfig.app.json --noEmit",
    "lint": "eslint src",
    "e2e": "playwright test",
    "format:check": "prettier --check src scripts/angular.mjs scripts/gerar-dtos.mjs scripts/aliases-dtos-http.mjs *.json *.ts *.js docs/contratos"
  },
  "private": true,
  "packageManager": "npm@11.16.0",
  "dependencies": {
    "@angular/cdk": "22.2.2",
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/material": "22.2.2",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@vitest/coverage-v8": "4.1.11",
    "angular-eslint": "22.5.0",
    "eslint": "10.12.0",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "6.0.2",
    "typescript-eslint": "8.71.1",
    "vitest": "^4.0.8"
  },
  "type": "module"
}
